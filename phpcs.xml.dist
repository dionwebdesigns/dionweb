<?xml version="1.0"?>
<ruleset name="WordPress Portfolio">
	<description>WordPress Coding Standards for the themes, plugin and demo script in this repository.</description>

	<file>./themes</file>
	<file>./plugins</file>
	<file>./demo</file>

	<!-- Generated and third-party code. src/ holds the block templates; build/ holds copies. -->
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="./"/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Lowest versions the code supports. -->
	<config name="minimum_wp_version" value="6.6"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="lintel"/>
				<element value="commons"/>
				<element value="groundwork"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="lintel"/>
				<element value="commons"/>
				<element value="groundwork"/>
				<element value="portfolio_demo"/>
			</property>
		</properties>
	</rule>

	<!-- Allows theme template names such as single-gw_project.php. -->
	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="is_theme" value="true"/>
		</properties>
	</rule>
</ruleset>
